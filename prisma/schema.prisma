// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
generator client {
  provider = "prisma-client-js"
}



enum Role {
  USER
  ADMIN
}

// role can only become ADMIN through scripts/make-admin.mjs, never through registration
model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  profileImage String?
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())

  homes        Home[]
  sessions     Session[]
}

// id is a SHA-256 hash of the session cookie's token, so a leaked database row can't be used to log in
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Home {
  id  String @id @default(uuid())
    
  title        String 
  description String  
  price       Int
  photo       String
  // Up to two more photos (MAX_GALLERY_PHOTOS), shown beside the description; the cover photo isn't repeated here
  gallery     String[]   @default([])
  location    String
  
  createdAt    DateTime   @default(now())

  // Optional only because listings created before accounts existed have no owner
  ownerId      String?
  owner        User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  favorites    Favorite[]
  reservations Reservation[]

  @@index([ownerId])
}

// guestId is the anonymous id from the guest cookie (lib/guest.ts) until accounts exist
model Favorite {
  id        String   @id @default(uuid())
  guestId   String
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([guestId, homeId])
}

model Reservation {
  id         String   @id @default(uuid())
  guestId    String
  homeId     String
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  checkIn    DateTime @db.Date
  checkOut   DateTime @db.Date
  guests     Int
  // Nights x the home's price at booking time, so later price changes don't alter it
  totalPrice Int
  createdAt  DateTime @default(now())

  @@index([guestId])
  @@index([homeId])
}
