// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
generator client {
  provider = "prisma-client-js"
}



model User {
id  String @id @default(uuid())
name String
email String
profileImage String?
}


model Home {
  id  String @id @default(uuid())
    
  title        String 
  description String  
  price       Int
  photo       String
  location    String
  
  createdAt    DateTime   @default(now())

  favorites    Favorite[]
  reservations Reservation[]
}

// guestId is the anonymous id from the guest cookie (lib/guest.ts) until accounts exist
model Favorite {
  id        String   @id @default(uuid())
  guestId   String
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([guestId, homeId])
}

model Reservation {
  id         String   @id @default(uuid())
  guestId    String
  homeId     String
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  checkIn    DateTime @db.Date
  checkOut   DateTime @db.Date
  guests     Int
  // Nights x the home's price at booking time, so later price changes don't alter it
  totalPrice Int
  createdAt  DateTime @default(now())

  @@index([guestId])
  @@index([homeId])
}
